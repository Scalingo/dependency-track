From 4843e9aa9b6398ca5c7a51af31a694b0614113d1 Mon Sep 17 00:00:00 2001
From: Thomas HENON <thomas.henon@scalingo.com>
Date: Wed, 15 Apr 2026 15:37:25 +0200
Subject: [PATCH] fix NullPointerException NPE when OS component has null name
 or version in TrivyAnalysisTask

---
 .../org/dependencytrack/tasks/scanners/TrivyAnalysisTask.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/main/java/org/dependencytrack/tasks/scanners/TrivyAnalysisTask.java b/src/main/java/org/dependencytrack/tasks/scanners/TrivyAnalysisTask.java
index f1752e8a7..31e51e20f 100644
--- a/src/main/java/org/dependencytrack/tasks/scanners/TrivyAnalysisTask.java
+++ b/src/main/java/org/dependencytrack/tasks/scanners/TrivyAnalysisTask.java
@@ -302,6 +302,10 @@ public class TrivyAnalysisTask extends BaseComponentAnalyzerTask implements Subs
                 }
 
             } else if (component.getClassifier() == Classifier.OPERATING_SYSTEM) {
+                if (component.getName() == null || component.getVersion() == null) {
+                    LOGGER.debug("Skipping OS component with missing name or version: %s".formatted(component));
+                    continue;
+                }
                 LOGGER.debug("add operative system %s".formatted(component.toString()));
                 var key = "%s-%s".formatted(component.getName(), component.getVersion());
                 os.put(key, OS.newBuilder().setFamily(component.getName()).setName(component.getVersion()).build());
-- 
2.43.0

