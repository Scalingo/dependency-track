From f8c12005181d98ba74893a76e0356897680b2481 Mon Sep 17 00:00:00 2001
From: Thomas HENON <thomas.henon@scalingo.com>
Date: Fri, 13 Feb 2026 10:52:04 +0100
Subject: [PATCH] fix: CI use GITHUB_TOKEN and allow to create a release

---
 .github/workflows/ci-publish.yaml |  6 ++++--
 .github/workflows/ci-release.yaml | 13 ++++++++-----
 2 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/.github/workflows/ci-publish.yaml b/.github/workflows/ci-publish.yaml
index de7668fc8..d70bdbdb0 100644
--- a/.github/workflows/ci-publish.yaml
+++ b/.github/workflows/ci-publish.yaml
@@ -37,7 +37,7 @@ jobs:
     uses: ./.github/workflows/_meta-build.yaml
     with:
       app-version: ${{ needs.read-version.outputs.version }}
-      publish-container: true
+      publish-container: false
       ref-name: ${{ github.ref_name }}
     permissions:
       security-events: write # Required to upload trivy's SARIF output
@@ -47,6 +47,8 @@ jobs:
 
   update-github-release:
     runs-on: ubuntu-latest
+    permissions:
+      contents: write
     needs:
       - read-version
       - call-build
@@ -73,7 +75,7 @@ jobs:
 
       - name: Update Release
         env:
-          GITHUB_TOKEN: ${{ secrets.BOT_RELEASE_TOKEN }}
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |-
           cat << EOF >> .github/default-release-notes.md
           \`\`\`text
diff --git a/.github/workflows/ci-release.yaml b/.github/workflows/ci-release.yaml
index 7ec6d90c6..aab7214b6 100644
--- a/.github/workflows/ci-release.yaml
+++ b/.github/workflows/ci-release.yaml
@@ -39,8 +39,6 @@ jobs:
   create-release:
     runs-on: ubuntu-latest
     permissions:
-      # Required for pushing changes via git command (rather than via GitHub API).
-      # TODO: Use bot credentials for git, or rewrite the "Commit Version" step to use API instead.
       contents: write
     needs:
       - prepare-release
@@ -65,7 +63,8 @@ jobs:
 
       - name: Commit Version
         env:
-          GITHUB_TOKEN: ${{ secrets.BOT_RELEASE_TOKEN }}
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |-
           MESSAGE="prepare-release: set version to ${VERSION}"
           CONTENT=$(base64 -i pom.xml)
@@ -99,7 +98,8 @@ jobs:
 
       - name: Create GitHub Release
         env:
-          GITHUB_TOKEN: ${{ secrets.BOT_RELEASE_TOKEN }}
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |-
           gh release create "${{ needs.prepare-release.outputs.version }}" \
             --target "${{ needs.prepare-release.outputs.release-branch }}" \
@@ -108,6 +108,8 @@ jobs:
 
   post-release:
     runs-on: ubuntu-latest
+    permissions:
+      contents: write
     needs:
       - prepare-release
       - create-release
@@ -127,7 +129,8 @@ jobs:
 
       - name: Commit SNAPSHOT Version
         env:
-          GITHUB_TOKEN: ${{ secrets.BOT_RELEASE_TOKEN }}
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |-
           MESSAGE="prepare-iteration: set version to ${NEXT_VERSION}"
           CONTENT=$(base64 -i pom.xml)
-- 
2.43.0

